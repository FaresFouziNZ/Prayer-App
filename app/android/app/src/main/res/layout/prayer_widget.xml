<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:layoutDirection="locale"
    android:background="@drawable/widget_background"
    android:padding="16dp">

    <!-- RemoteViews only inflates a fixed whitelist of view classes; a bare
         <View> isn't on it, so a childless FrameLayout stands in for the
         solid-color accent bar. -->
    <FrameLayout
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:background="@drawable/widget_accent_bar"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="14dp"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_prayer_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_text_primary"
            android:textSize="19sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/widget_adhan_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/widget_text_secondary"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/widget_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/widget_accent"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"/>

        <!-- FR-WD-03: one dot per prayer (Fajr..Isha), tinted by today's log
             status in PrayerWidgetProvider. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_dot_0"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:src="@drawable/widget_status_dot"/>

            <ImageView
                android:id="@+id/widget_dot_1"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/widget_status_dot"/>

            <ImageView
                android:id="@+id/widget_dot_2"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/widget_status_dot"/>

            <ImageView
                android:id="@+id/widget_dot_3"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/widget_status_dot"/>

            <ImageView
                android:id="@+id/widget_dot_4"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/widget_status_dot"/>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
